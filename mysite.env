# Example env file for wp-security-check.sh: copy it (one per site, or one shared), edit it and pass it with --env.
# Values must be quoted. Keep the file private: chmod 600
TELEGRAM_BOT_TOKEN="<chat-token>"
TELEGRAM_CHAT_ID="<chat-id>"

# Optional (defaults shown):
# SEND_ALWAYS="1"      # 1 = also send a message when there are no ALERTs
# WP_BIN="wp"          # path to the WP-CLI executable
# RECENT_MIN="1500"    # "recently modified PHP files" window, in minutes
